LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxx
LIVEKIT_API_SECRET=secretxxxxxxxx
LIVEKIT_AGENT_NAME=standin-agent
BRIDGE_SECRET=change-me
PORT=9442

# Path the bridge answers on; StandIn appends /{callId}. Default /msteams/calling, which is what an
# identity registered with a bare host will reach. Change it only to avoid a collision with
# something else sharing this origin.
WS_PATH=/msteams/calling
