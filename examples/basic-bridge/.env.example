LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxx
LIVEKIT_API_SECRET=secretxxxxxxxx
LIVEKIT_AGENT_NAME=standin-agent
BRIDGE_SECRET=change-me
PORT=8080

# Path the bridge answers on; StandIn appends /{callId}. Default /msteams/calling, matching the
# OpenClaw and Hermes plugins so one identity URL shape works for every backend. Change it only to
# avoid a collision with something else sharing this origin.
WS_PATH=/msteams/calling
