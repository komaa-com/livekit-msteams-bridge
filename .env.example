# --- required ---
# LiveKit server (LiveKit Cloud project URL or self-hosted)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxx
LIVEKIT_API_SECRET=secretxxxxxxxx
# the shared secret from your StandIn identity (pairing issues it); must match exactly
BRIDGE_SECRET=change-me

# --- LiveKit agent dispatch ---
# EXPLICIT dispatch (LiveKit's recommended model). Set this to the exact agent_name
# your worker registers with (the example agents use "standin-agent" /
# all three examples register as "standin-agent"; run ONE at a time, since explicit dispatch
# resolves a single name).
# WARNING: a worker that registers a name is ONLY reachable by explicit dispatch. If
# your worker sets agent_name but you leave this unset, the bridge falls back to
# automatic dispatch and your agent will NEVER join the call - the single most common
# setup mistake. Leave this unset ONLY if your worker also registers with no name
# (automatic dispatch, joins every room; prototype-only).
LIVEKIT_AGENT_NAME=standin-agent
# room per call: `${prefix}${callId}`
LIVEKIT_ROOM_PREFIX=msteams-
# delete the room at teardown so the agent job ends immediately (billing hygiene)
LIVEKIT_DELETE_ROOM_ON_END=true

# --- avatar video on the Teams tile ---
# By default (auto) the bridge relays an avatar agent's video onto the caller's
# Teams tile. Set to off for audio-only (the tile shows StandIn's built-in
# animated avatar); or name a specific participant identity. Voice-only agents
# publish no avatar video, so auto has no effect for them. FPS = relay send rate.
#LIVEKIT_TILE_VIDEO=off
#LIVEKIT_TILE_VIDEO_FPS=15

# --- ambient vision (caller screen-share / camera -> the agent) ---
# OFF by default: this is the knob that spends money. When on, the newest frame from
# each source is published to the room as a byte stream on the "msteams.vision" topic,
# labelled with whose screen/camera it is. Only CHANGED frames are sent, so a frozen
# screen costs nothing. Read it with room.register_byte_stream_handler("msteams.vision").
#AMBIENT_VISION=true
# Per-call spend cap over a sliding 60s window. 0 DISABLES the feature - it does not mean
# "unlimited". For a high cap, set a high number.
#MAX_VISION_PER_MINUTE=30
# Hold frames back until Teams reports the call recording as active (Media Access rule).
#REQUIRE_RECORDING_STATUS=true

# --- group-call gate (speak only when addressed, in meetings) ---
# 1:1 calls are never gated. In a call with 2+ humans the bridge tells the agent to stay
# quiet unless addressed by one of the wake phrases, and withholds its audio from Teams
# while it is not. Set requireAddress=false to opt out entirely (emptying the wake-phrase
# list does NOT opt out - it would be a mute switch, so it falls back to the default).
#GROUP_CALL_REQUIRE_ADDRESS=true
#GROUP_CALL_WAKE_PHRASES=assistant
# Keep answering for this long after being addressed, without being named again.
# 0 = "address me every turn", which also disables the audio-egress backstop.
#GROUP_CALL_FOLLOW_UP_WINDOW_MS=12000

# --- optional ---
PORT=8080
BIND=0.0.0.0
# End a call whose agent never joined the room, after this many seconds. 0 disables.
# Covers the most common setup mistake (LIVEKIT_AGENT_NAME not matching the worker's
# agent_name): without it the caller sits on a silent call that nothing ever ends.
STALE_CALL_REAPER_SECONDS=120
# bridge-side call governor: hard cap in minutes (fractional ok); 0 = disabled
MAX_CALL_MINUTES=0
#GOODBYE_TEXT=I'm sorry, we've reached the time limit for this call. Thank you for calling, goodbye!
GOODBYE_GRACE_MS=8000
# HMAC replay window in ms (worker documents ±60s)
HMAC_FRESHNESS_MS=60000
# DoS guards (0 = built-in defaults: 64 / no per-IP throttle / 10000 / 90000)
MAX_CONNECTIONS=0
MAX_CONNECTIONS_PER_IP=0
PRE_START_TIMEOUT_MS=0
WORKER_IDLE_TIMEOUT_MS=0
# per-IP cap behind a proxy you control: trust the first X-Forwarded-For hop
TRUST_PROXY_XFF=false
LOG_LEVEL=info
